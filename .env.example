# AList must use an internal or loopback URL in production.
ALIST_BASE_URL=http://127.0.0.1:5244
# Prefer dedicated-user credentials so the client can obtain a fresh token.
ALIST_USERNAME=dorm-memorial
ALIST_PASSWORD=
# Browser-copied token remains available as a fallback for short diagnostics.
ALIST_TOKEN=
# Path visible to this dedicated account. Use / when its AList base path is already restricted to 3048.
ALIST_ROOT=/

# Dorm Memorial application (phase 1)
APP_ENV=development
APP_ADDRESS=127.0.0.1:8080
APP_DATABASE_PATH=data/dorm-memorial.db
APP_FRONTEND_DIR=web/dist
APP_PUBLIC_URL=http://127.0.0.1:8080
APP_COOKIE_SECURE=false
APP_SESSION_TTL=720h
# Recently uploaded or fully viewed media is cached locally with LRU eviction.
APP_MEDIA_CACHE_DIR=data/media-cache
APP_MEDIA_CACHE_MAX_BYTES=2147483648
# Maximum size of a single video upload (150 MiB). Recommend compressing larger videos before upload.
APP_MAX_VIDEO_UPLOAD_BYTES=157286400
APP_FFMPEG_PATH=ffmpeg

# Used only to create the first administrator in an empty database.
# Remove these values after the first successful startup.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NICKNAME=
