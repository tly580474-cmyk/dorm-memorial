+func newStreamingUploadBody(ctx context.Context, file model.FileStreamer, token string, puid int) (io.ReadCloser, string, int64, error) {
+	if file == nil || file.GetSize() < 0 {
+		return nil, "", 0, errors.New("invalid upload file")
+	}
+
+	var framing bytes.Buffer
+	framingWriter := multipart.NewWriter(&framing)
+	boundary := framingWriter.Boundary()
+	if _, err := framingWriter.CreateFormFile("file", file.GetName()); err != nil {
+		return nil, "", 0, err
+	}
+	if err := framingWriter.WriteField("_token", token); err != nil {
+		return nil, "", 0, err
+	}
+	if err := framingWriter.WriteField("puid", fmt.Sprintf("%d", puid)); err != nil {
+		return nil, "", 0, err
+	}
+	if err := framingWriter.Close(); err != nil {
+		return nil, "", 0, err
+	}
+
+	reader, writer := io.Pipe()
+	go func() {
+		multipartWriter := multipart.NewWriter(writer)
+		if err := multipartWriter.SetBoundary(boundary); err != nil {
+			_ = writer.CloseWithError(err)
+			return
+		}
+		filePart, err := multipartWriter.CreateFormFile("file", file.GetName())
+		if err == nil {
+			_, err = utils.CopyWithBuffer(filePart, file)
+		}
+		if err == nil {
+			err = multipartWriter.WriteField("_token", token)
+		}
+		if err == nil {
+			err = multipartWriter.WriteField("puid", fmt.Sprintf("%d", puid))
+		}
+		if err == nil {
+			err = multipartWriter.Close()
+		}
+		if err == nil {
+			if contextErr := ctx.Err(); contextErr != nil {
+				err = contextErr
+			}
+		}
+		_ = writer.CloseWithError(err)
+	}()
+
+	return reader, "multipart/form-data; boundary=" + boundary, int64(framing.Len()) + file.GetSize(), nil
+}
+
 var _ driver.Driver = (*ChaoXing)(nil)
