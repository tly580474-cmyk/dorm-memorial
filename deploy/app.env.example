APP_ENV=production
APP_ADDRESS=127.0.0.1:8080
APP_DATABASE_PATH=/var/lib/dorm-memorial/app.db
APP_FRONTEND_DIR=/opt/dorm-memorial/current/web
APP_PUBLIC_URL=https://3048.clical.xin
APP_COOKIE_SECURE=true
APP_SESSION_TTL=720h
APP_MEDIA_CACHE_DIR=/var/cache/dorm-memorial/media
APP_MEDIA_CACHE_MAX_BYTES=2147483648
# Maximum size of a single video upload (300 MiB). Recommend compressing larger videos before upload.
APP_MAX_VIDEO_UPLOAD_BYTES=314572800
# Maximum size of a single image upload (15 MiB). Original bytes are never re-encoded.
APP_MAX_IMAGE_UPLOAD_BYTES=15728640
APP_FFMPEG_PATH=ffmpeg
# Set only for the first start, then remove from this file.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NICKNAME=

# AList account restricted to the 3048 memorial folder. When its AList base path
# is already 3048, keep ALIST_ROOT=/ to avoid addressing the folder twice.
ALIST_BASE_URL=http://127.0.0.1:5244
ALIST_USERNAME=dorm-memorial
ALIST_PASSWORD=
ALIST_TOKEN=
ALIST_ROOT=/
