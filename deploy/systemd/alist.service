[Unit]
Description=AList storage gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alist
Group=alist
WorkingDirectory=/var/lib/alist
ExecStart=/opt/alist/alist server --data /var/lib/alist
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryHigh=384M
MemoryMax=640M
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alist
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027

[Install]
WantedBy=multi-user.target
